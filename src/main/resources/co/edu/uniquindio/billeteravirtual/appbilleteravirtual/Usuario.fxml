<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.billeteravirtual.appbilleteravirtual.viewController.UsuarioViewController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
   <children>
   
       <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="INFORMACIÓN DEL USUARIO" />
       <Separator />
   
       <GridPane hgap="10" vgap="10">
           <columnConstraints>
               <ColumnConstraints minWidth="150" />
               <ColumnConstraints minWidth="300" />
           </columnConstraints>
      <children>
      
              <Label text="ID Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
              <TextField fx:id="txtIdUsuario" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      
              <Label text="Nombre Completo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
              <TextField fx:id="txtNombreCompleto" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      
              <Label text="Correo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
              <TextField fx:id="txtCorreo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      
              <Label text="Número Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
              <TextField fx:id="txtNumeroTelefono" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      
              <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
              <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      
              <Label text="Saldo:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
              <TextField fx:id="txtSaldo" GridPane.columnIndex="1" GridPane.rowIndex="5" />
      </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
       </GridPane>

       <Button maxWidth="200" onAction="#onAgregarUsuario" text="Agregar Usuario">
           <VBox.margin>
               <Insets top="10" />
           </VBox.margin>
       </Button>
       <Button text="Editar Usuario" maxWidth="200" onAction="#onEditarUsuario">
           <VBox.margin>
               <Insets top="5"/>
           </VBox.margin>
       </Button>
       <Button text="Eliminar" maxWidth="200" onAction="#onEliminarUsuario">
           <VBox.margin>
               <Insets top="10"/>
           </VBox.margin>
       </Button>
       <Button text="Buscar" onAction="#onBuscarUsuario"/>
       <Button text="Limpiar" onAction="#onLimpiarDatos" />
   
       <TableView fx:id="tableViewUsuarios" prefHeight="300">
           <columns>
               <TableColumn fx:id="colIdUsuario" prefWidth="100" text="ID Usuario" />
               <TableColumn fx:id="colNombreCompleto" prefWidth="150" text="Nombre Completo" />
               <TableColumn fx:id="colCorreo" prefWidth="150" text="Correo" />
               <TableColumn fx:id="colNumeroTelefono" prefWidth="100" text="Teléfono" />
               <TableColumn fx:id="colDireccion" prefWidth="150" text="Dirección" />
               <TableColumn fx:id="colSaldo" prefWidth="100" text="Saldo" />
           </columns>
       </TableView>
   </children>
</VBox>
